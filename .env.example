# Copia este archivo a .env.local / .env.dev / .env.prd y ajusta los valores,
# luego corre `npm run env:local` (o env:dev / env:prd) para activarlo como .env.
#
# Todo lo que empiece por EXPO_PUBLIC_ viaja dentro del bundle de la app:
# nunca pongas aquí secretos o llaves privadas.

# local | dev | prd — controla el nivel de logs (ver src/core/logger)
EXPO_PUBLIC_ENVIRONMENT=local

# Base del API, incluyendo /api. En desarrollo usa la IP LAN de tu máquina,
# no localhost: un celular físico o el simulador de iOS no la alcanzan.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.17:3000/api

# Prefijo de las rutas de autenticación dentro del API (default: /auth)
EXPO_PUBLIC_API_AUTH_PREFIX=/auth

# Timeout de las peticiones HTTP en milisegundos (default: 20000).
# Con un backend gratuito que se duerme (Render), su arranque en frío tarda ~50s:
# usa 60000 para que la primera petición al reabrir la app no venza antes de que
# el servicio despierte. Mientras tanto la app muestra la info guardada en caché.
EXPO_PUBLIC_API_TIMEOUT_MS=60000
